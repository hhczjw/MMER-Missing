        },
        "IEMOCAP": {
            "task_type": "classification",
            "num_classes": 4,
            "featurePath": "IEMOCAP/Processed/iemocap_unaligned.pkl",
            "feature_dims": [768, 100, 342],
            "seq_lens": [50, 1500, 500],
            "batch_size": 32,
            "learning_rate": 1e-4,
            "epochs": 50,
            "KeyEval": "F1"
        }
