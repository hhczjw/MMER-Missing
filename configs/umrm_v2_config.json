            "seq_lens": [50, 50, 50],
            "batch_size": 32,
            "learning_rate": 1e-4,
            "weight_decay": 0.0001,
            "epochs": 120,
            "KeyEval": "MAE"
        },
        "MOSEI": {
            "task_type": "regression",
            "num_classes": 1,
            "featurePath": "CMU-MOSEI/Processed/unaligned_50.pkl",
            "feature_dims": [768, 74, 35],
            "seq_lens": [50, 500, 375],
            "batch_size": 32,
            "learning_rate": 1e-4,
            "epochs": 30,
