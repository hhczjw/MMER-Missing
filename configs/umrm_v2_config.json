{
    "dataset_root_dir": "/media/zjw/951FB31A9E1EB7E0/dateSet/MSA-DataSets",
    "model": {
        "name": "UMRMv2",
        "d_model": 128,
        "num_layers": 2,
        "d_state": 64,
